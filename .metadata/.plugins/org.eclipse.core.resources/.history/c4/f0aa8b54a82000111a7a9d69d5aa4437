/**
 * JavaOS Iron v4.96 [Disk Controller Fix].
 * Architecture:
 * - Switch-Case Parser: Dispatches execution based *only* on the first char.
 * - Strict Verification: Exact string matching.
 * - Full Set: DIR, CLS, VER, CMD, HELP, SAVE, TYPE.
 * - Fix: processDiskController now reads addresses in Little Endian to match CPU STORE.
 */
public class Machine extends JFrame {
    private static final long serialVersionUID = 1L;
    
    public static final int MEM_SIZE = 1024 * 1024; 
    public static final int KBD_ADDR = 0xA000;      
    public static final int VRAM_ADDR = 0x80000;    
    public static final int TEXT_ADDR = 0xB8000;    
    public static final int FONT_ADDR = 0xE0000;    
    public static final int ROM_ADDR = 0xF0000;
    public static final int DATA_ADDR = 0x10000;
    
    public static final int CURSOR_X_ADDR = 0xA0010;
    public static final int CURSOR_Y_ADDR = 0xA0011;
    public static final int DISK_SECTOR_ADDR = 0xA0020; 
    public static final int DISK_BUFFER_ADDR = 0xA0024; 
    public static final int DISK_CMD_ADDR = 0xA0028;    

    public static final int SECTOR_SIZE = 512;
    public static final int DISK_SIZE = 1024 * 1024; 
    private final String DISK_FILENAME = "iron_disk.img";
    
    private final byte[] ram = new byte[MEM_SIZE];
    private final byte[] disk = new byte[DISK_SIZE]; 
    private final CPU cpu;
    private final GPU gpu;
    private boolean poweredOn = false;

    public Machine() {
        this.cpu = new CPU(ram);
        this.gpu = new GPU(ram);
        
        setTitle("JavaOS Iron v4.96 [Disk Controller Fix]");
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setResizable(false);
        add(gpu, BorderLayout.CENTER);
        pack();
        setLocationRelativeTo(null);

        addKeyListener(new KeyAdapter() {
            @Override
            public void keyPressed(KeyEvent e) {
                if (cpu.isPanic()) return;
                char c = e.getKeyChar();
                if (c == '\r') c = '\n';
                if (e.getKeyCode() == KeyEvent.VK_BACK_SPACE) c = 8;
                if (c != KeyEvent.CHAR_UNDEFINED) {
                    ram[KBD_ADDR] = (byte) Character.toUpperCase(c);
                    cpu.triggerInterrupt(1);
                }
            }
        });
    }

    public void powerOn() {
        System.out.println("[ HW ] Iron v4.96 Powering On...");
        poweredOn = true;
        loadDiskImage();
        initializeHardware();
        loadBIOS();
        
        new Thread(this::runExecutionLoop, "vCPU-Thread").start();
        new Thread(gpu::refreshLoop, "vGPU-Thread").start();
        new Thread(this::runHardwareTimer, "vTimer-Thread").start();
        
        setVisible(true);
    }

    private void loadDiskImage() {
        Path path = Paths.get(DISK_FILENAME);
        if (Files.exists(path)) {
            try {
                byte[] data = Files.readAllBytes(path);
                System.arraycopy(data, 0, disk, 0, Math.min(data.length, DISK_SIZE));
                System.out.println("[ DISK ] Host image loaded.");
            } catch (IOException e) {
                System.err.println("[ DISK ] Load Error.");
            }
        } else {
            formatDisk();
        }
    }

    private void formatDisk() {
        for (int i = 0; i < DISK_SIZE; i++) disk[i] = 0;
        String header = "--- IRON-DOS FILE SYSTEM ---\n\r";
        System.arraycopy(header.getBytes(), 0, disk, SECTOR_SIZE, header.length());
        saveDiskToHost();
    }

    private void saveDiskToHost() {
        try (FileOutputStream fos = new FileOutputStream(DISK_FILENAME)) {
            fos.write(disk);
        } catch (IOException ignored) {}
    }

    private void initializeHardware() {
        for (int i = 0; i < 320 * 200; i++) ram[VRAM_ADDR + i] = 1; 
        for (int i = 0; i < 320 * 12; i++) ram[VRAM_ADDR + i] = 15;
        for (int i = 320 * 12; i < 320 * 14; i++) ram[VRAM_ADDR + i] = 4;
        for (int i = 0; i < 2000; i++) ram[TEXT_ADDR + i] = (byte)0xFF;

        ram[CURSOR_X_ADDR] = 0;
        ram[CURSOR_Y_ADDR] = 4;

        for (int i = 0; i < 256; i++) {
            byte[] glyph = generateSimpleChar((char)i);
            System.arraycopy(glyph, 0, ram, FONT_ADDR + (i * 8), 8);
        }

        String bootMsg = "IRON V4.96 KERNEL LOADED SUCCESS...\n\0";
        byte[] msgBytes = bootMsg.getBytes();
        System.arraycopy(msgBytes, 0, ram, DATA_ADDR, msgBytes.length);
    }

    private void processDiskController() {
        int cmd = ram[DISK_CMD_ADDR] & 0xFF;
        if (cmd == 0) return;
        
        // FIXED: Use Little Endian decoding to match CPU STORE behavior
        // Previous Big Endian read caused '1' to be read as '65536'
        int sectorIdx = (ram[DISK_SECTOR_ADDR] & 0xFF) | 
                       ((ram[DISK_SECTOR_ADDR+1] & 0xFF) << 8) | 
                       ((ram[DISK_SECTOR_ADDR+2] & 0xFF) << 16);
                       
        int bufferAddr = (ram[DISK_BUFFER_ADDR] & 0xFF) | 
                        ((ram[DISK_BUFFER_ADDR+1] & 0xFF) << 8) | 
                        ((ram[DISK_BUFFER_ADDR+2] & 0xFF) << 16);
                        
        int diskOffset = sectorIdx * SECTOR_SIZE;
        
        if (cmd == 1 && diskOffset < disk.length) System.arraycopy(disk, diskOffset, ram, bufferAddr, SECTOR_SIZE);
        else if (cmd == 2 && diskOffset < disk.length) {
            System.arraycopy(ram, bufferAddr, disk, diskOffset, SECTOR_SIZE);
            saveDiskToHost();
        }
        ram[DISK_CMD_ADDR] = 0;
    }

    private void runExecutionLoop() {
        while (poweredOn) {
            if (cpu.isPanic()) break;
            processDiskController();
            for (int i = 0; i < 3000; i++) cpu.step();
            try { Thread.sleep(1); } catch (InterruptedException e) { break; }
        }
    }

    private void runHardwareTimer() {
        while (poweredOn) {
            try { Thread.sleep(200); } catch (InterruptedException e) { break; }
            cpu.triggerInterrupt(0);
        }
    }

