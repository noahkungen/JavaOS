package com.javaos;

/**
 * Entry point. Simulates the BIOS/EFI boot sequence.
 */
public class Bootloader {

    public static void main(String[] args) throws InterruptedException {
        System.out.println("\033[H\033[2J"); // ANSI Clear Screen
        System.out.println("JavaOS Boot Manager v1.0");
        System.out.println("Initializing Virtual Hardware...");
        
        // Simulation Delays (Immersiveness)
        printStatus("CPU", "Detecting Virtual Cores (Project Loom)");
        Thread.sleep(300);
        
        printStatus("RAM", "Allocating Jimfs Heap Memory");
        Thread.sleep(300);
        
        printStatus("VFS", "Mounting Root Filesystem");
        // Initialize Kernel (which in turn initializes VFS)
        Kernel.getInstance(); 
        Thread.sleep(400);

        System.out.println("\nBoot complete. Launching Shell...\n");
        Thread.sleep(500);

        // Handover to User Space
        new Shell().start();
    }

    private static void printStatus(String component, String action) {
        // Basic ANSI coloring
        String green = "\u001B[32m";
        String reset = "\u001B[0m";
        System.out.printf("[%sOK%s] %s: %s%n", green, reset, component, action);
    }
}